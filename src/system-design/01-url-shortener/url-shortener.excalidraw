    {"id":"db-annotation","type":"text","x":900,"y":552,"width":280,"height":22,"text":"Durable source of truth","originalText":"Durable source of truth","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300010,"version":1,"versionNonce":300010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"record","type":"text","x":40,"y":625,"width":1100,"height":70,"text":"Example: id 125000000000 -> Base62 -> code 2crtgcg\nStored: {id, code, long_url}; GET /2crtgcg resolves https://example.com/article\nCreate: look up exact long_url; reuse its code, or allocate ID, encode, INSERT.","originalText":"Example: id 125000000000 -> Base62 -> code 2crtgcg\nStored: {id, code, long_url}; GET /2crtgcg resolves https://example.com/article\nCreate: look up exact long_url; reuse its code, or allocate ID, encode, INSERT.","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300011,"version":1,"versionNonce":300011,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"read-path","type":"text","x":40,"y":800,"width":1100,"height":65,"text":"GET /{code}: cache hit -> 302; miss -> DB read -> API fills cache -> 302.\n302 returns Location plus Cache-Control: no-store in this demo.\nThe browser then fetches the destination with a separate GET.","originalText":"GET /{code}: cache hit -> 302; miss -> DB read -> API fills cache -> 302.\n302 returns Location plus Cache-Control: no-store in this demo.\nThe browser then fetches the destination with a separate GET.","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300012,"version":1,"versionNonce":300012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"limits","type":"text","x":40,"y":975,"width":1100,"height":45,"text":"Global ID allocation is a conceptual dependency, not an implementation here.\nAPI replicas alone do not provide failover for the allocator, DB, or cache.","originalText":"Global ID allocation is a conceptual dependency, not an implementation here.\nAPI replicas alone do not provide failover for the allocator, DB, or cache.","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300013,"version":1,"versionNonce":300013,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"id-generator","type":"rectangle","x":600,"y":130,"width":160,"height":70,"strokeColor":"#dedbd2","backgroundColor":"#fffdf8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400001,"version":2,"versionNonce":400001,"isDeleted":false,"groupIds":["id-generator-group"],"boundElements":[{"id":"id-to-api","type":"arrow"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"id-generator-label","type":"text","x":654,"y":144,"width":96,"height":48.75,"text":"ID generator\nglobally\nunique","originalText":"ID generator\nglobally\nunique","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400002,"version":3,"versionNonce":400002,"isDeleted":false,"groupIds":["id-generator-group"],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"id-to-api","type":"arrow","x":680,"y":205,"width":0,"height":65,"points":[[0,0],[0,65]],"startBinding":{"elementId":"id-generator","focus":0,"gap":5},"endBinding":{"elementId":"api-a","focus":0,"gap":5},"startArrowhead":null,"endArrowhead":"arrow","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400003,"version":1,"versionNonce":400003,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"creation-id-note","type":"text","x":40,"y":140,"width":510,"height":65,"text":"Creation on either API replica:\nReuse an existing code, or obtain a global ID.\nBase62 encodes the ID; it does not hash the URL.","originalText":"Creation on either API replica:\nReuse an existing code, or obtain a global ID.\nBase62 encodes the ID; it does not hash the URL.","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400004,"version":1,"versionNonce":400004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"id-range","type":"text","x":40,"y":715,"width":1100,"height":60,"text":"At most 7 Base62 characters: allocate 0 <= id < 62^7 = 3,521,614,606,208.\nNot every 64-bit ID fits in 7 characters; use leading zeros if fixed width is required.\nAlphabet: 0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ","originalText":"At most 7 Base62 characters: allocate 0 <= id < 62^7 = 3,521,614,606,208.\nNot every 64-bit ID fits in 7 characters; use leading zeros if fixed width is required.\nAlphabet: 0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500001,"version":1,"versionNonce":500001,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"capacity-estimate","type":"text","x":40,"y":890,"width":1100,"height":65,"text":"Sizing assumptions: 100M creates/day, 10 reads/create, 10 years -> 365B records.\nAt 100 bytes per URL: 36.5 TB raw URL payload, excluding metadata, indexes and replicas.\nConcurrent duplicate creates still need an atomic get-or-create or a uniqueness rule.","originalText":"Sizing assumptions: 100M creates/day, 10 reads/create, 10 years -> 365B records.\nAt 100 bytes per URL: 36.5 TB raw URL payload, excluding metadata, indexes and replicas.\nConcurrent duplicate creates still need an atomic get-or-create or a uniqueness rule.","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500002,"version":1,"versionNonce":500002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"source-note","type":"text","x":40,"y":1050,"width":1100,"height":25,"text":"Concepts: Alex Xu, System Design Interview, Vol. 1, chapter 8. Original diagram.","originalText":"Concepts: Alex Xu, System Design Interview, Vol. 1, chapter 8. Original diagram.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500003,"version":1,"versionNonce":500003,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
