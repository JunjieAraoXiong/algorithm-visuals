    {"id":"burst-result","type":"text","x":40,"y":675,"width":480,"height":90,"text":"R1       R2       R3       R4\n3 -> 2   2 -> 1   1 -> 0   0 -> 0\nPASS     PASS     PASS     429","originalText":"R1       R2       R3       R4\n3 -> 2   2 -> 1   1 -> 0   0 -> 0\nPASS     PASS     PASS     429","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.5,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103004,"version":1,"versionNonce":103004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
