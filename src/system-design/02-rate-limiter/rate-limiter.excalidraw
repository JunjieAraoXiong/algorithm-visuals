    {"id":"refill-label","type":"text","x":720,"y":380,"width":350,"height":45,"text":"Elapsed time refills tokens\nService completion does not","originalText":"Elapsed time refills tokens\nService completion does not","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":102010,"version":1,"versionNonce":102010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
