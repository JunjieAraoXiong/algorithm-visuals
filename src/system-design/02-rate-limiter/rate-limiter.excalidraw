    {"id":"saturate-time","type":"text","x":830,"y":605,"width":250,"height":25,"text":"t = 11 s: idle +10 s","originalText":"t = 11 s: idle +10 s","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103007,"version":1,"versionNonce":103007,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"saturate-result","type":"text","x":830,"y":675,"width":270,"height":90,"text":"min(3, 0 + 10) = 3\nR6: 3 -> 2\nPASS","originalText":"min(3, 0 + 10) = 3\nR6: 3 -> 2\nPASS","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.5,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103008,"version":1,"versionNonce":103008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"boundary-note","type":"text","x":40,"y":795,"width":1060,"height":70,"text":"Capacity bounds the accumulated burst; refill rate bounds sustained throughput.\nRetry-After: 1 is a hint in this example, not a reserved slot.\nThis demo uses whole-second refill and ordered requests; no backend or real clock.","originalText":"Capacity bounds the accumulated burst; refill rate bounds sustained throughput.\nRetry-After: 1 is a hint in this example, not a reserved slot.\nThis demo uses whole-second refill and ordered requests; no backend or real clock.","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.3,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103009,"version":1,"versionNonce":103009,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"scale-note","type":"text","x":40,"y":895,"width":1060,"height":70,"text":"Multiple gateways must share one quota owner for a key. Refill/check/consume is atomic.\nA separate full bucket per gateway multiplies the available quota.\nShared state adds latency and failure handling: decide whether to fail open or closed.","originalText":"Multiple gateways must share one quota owner for a key. Refill/check/consume is atomic.\nA separate full bucket per gateway multiplies the available quota.\nShared state adds latency and failure handling: decide whether to fail open or closed.","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.3,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103010,"version":1,"versionNonce":103010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"source-note","type":"text","x":40,"y":995,"width":1060,"height":25,"text":"Concepts: Alex Xu, System Design Interview, chapter 4. Original diagram and example.","originalText":"Concepts: Alex Xu, System Design Interview, chapter 4. Original diagram and example.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103011,"version":1,"versionNonce":103011,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null}
