    {"id":"stage_caption","type":"text","x":40,"y":420,"width":620,"height":60,"text":"W 决定等待多少确认。\n成功返回不表示三个副本都已更新。","originalText":"W 决定等待多少确认。\n成功返回不表示三个副本都已更新。","fontSize":23,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100017,"version":1,"versionNonce":100017,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25}
    ,{"id":"comparison_rule","type":"line","x":40,"y":550,"width":1080,"height":0,"points":[[0,0],[1080,0]],"strokeColor":"#b7b7b1","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200001,"version":1,"versionNonce":200001,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"stale_title","type":"text","x":40,"y":590,"width":480,"height":40,"text":"W=1，R=1：可以读到旧版本","originalText":"W=1，R=1：可以读到旧版本","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200002,"version":1,"versionNonce":200002,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"stale_evidence","type":"text","x":40,"y":650,"width":480,"height":170,"text":"写确认集合：{ A }\n前 R 个读响应：{ C:v0 }\n集合没有交集\n\n返回 light (v0)","originalText":"写确认集合：{ A }\n前 R 个读响应：{ C:v0 }\n集合没有交集\n\n返回 light (v0)","fontSize":23,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200003,"version":1,"versionNonce":200003,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"fresh_title","type":"text","x":620,"y":590,"width":500,"height":40,"text":"W=2，R=2：固定集合必相交","originalText":"W=2，R=2：固定集合必相交","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200004,"version":1,"versionNonce":200004,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"fresh_evidence","type":"text","x":620,"y":650,"width":500,"height":170,"text":"写确认集合：{ A, B }\n前 R 个读响应：{ C:v0, B:v1 }\n交集至少包含 B；取最大版本\n\n返回 dark (v1)","originalText":"写确认集合：{ A, B }\n前 R 个读响应：{ C:v0, B:v1 }\n交集至少包含 B；取最大版本\n\n返回 dark (v1)","fontSize":23,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200005,"version":1,"versionNonce":200005,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"intersection_boundary","type":"text","x":40,"y":850,"width":1080,"height":120,"text":"R + W > N 只给出固定集合的交集条件。\n本例还要求：成功写后再读、无并发写、版本可比较、已确认数据不丢失。\n这条不等式不能单独证明任意并发和故障下的线性一致性。","originalText":"R + W > N 只给出固定集合的交集条件。\n本例还要求：成功写后再读、无并发写、版本可比较、已确认数据不丢失。\n这条不等式不能单独证明任意并发和故障下的线性一致性。","fontSize":23,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200006,"version":1,"versionNonce":200006,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"timeout_title","type":"text","x":40,"y":1010,"width":1080,"height":40,"text":"副本离线：等待数越大，越可能无法完成","originalText":"副本离线：等待数越大，越可能无法完成","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300001,"version":1,"versionNonce":300001,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"timeout_evidence","type":"text","x":40,"y":1075,"width":1080,"height":120,"text":"C 离线，W=3：只有 A、B 确认；超时，结果不确定。\nA、B 可能已经写入，超时不能证明写入没发生。\nC 离线，R=3：最多两个响应；返回不可用，不偷偷降低 R。","originalText":"C 离线，W=3：只有 A、B 确认；超时，结果不确定。\nA、B 可能已经写入，超时不能证明写入没发生。\nC 离线，R=3：最多两个响应；返回不可用，不偷偷降低 R。","fontSize":23,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300002,"version":1,"versionNonce":300002,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"recovery","type":"text","x":40,"y":1230,"width":1080,"height":120,"text":"恢复连接 → 补齐同一个 v1 → 三副本收敛。\n协调者在此例中保留 v1；真实系统还需要日志与恢复协议。\n补齐数据不会追溯修改先前已返回的旧读或超时。","originalText":"恢复连接 → 补齐同一个 v1 → 三副本收敛。\n协调者在此例中保留 v1；真实系统还需要日志与恢复协议。\n补齐数据不会追溯修改先前已返回的旧读或超时。","fontSize":23,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300003,"version":1,"versionNonce":300003,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25},
    {"id":"attribution","type":"text","x":40,"y":1400,"width":1080,"height":75,"text":"参考：Alex Xu，《System Design Interview》第二版，第 6 章。\n图解与请求顺序为原创教学示例；不是完整 Dynamo 实现。","originalText":"参考：Alex Xu，《System Design Interview》第二版，第 6 章。\n图解与请求顺序为原创教学示例；不是完整 Dynamo 实现。","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300004,"version":1,"versionNonce":300004,"isDeleted":false,"groupIds":[],"boundElements":null,"containerId":null,"link":null,"locked":false,"lineHeight":1.25}
