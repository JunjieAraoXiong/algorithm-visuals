    {"id":"virtual-note","type":"text","x":40,"y":710,"width":1010,"height":75,"text":"Virtual nodes: one physical server owns several separated ring intervals.\nSame 12 keys, A/B/C: 1 token each -> 4/2/6; 3 tokens each -> 4/4/4.\nThis sample is balanced; more tokens do not guarantee every sample improves.","originalText":"Virtual nodes: one physical server owns several separated ring intervals.\nSame 12 keys, A/B/C: 1 token each -> 4/2/6; 3 tokens each -> 4/4/4.\nThis sample is balanced; more tokens do not guarantee every sample improves.","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":540001,"version":1,"versionNonce":540001,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
    {"id":"limits","type":"text","x":40,"y":811,"width":1010,"height":50,"text":"Virtual nodes are not replicas. A hot key still has one owner in this model.\nFailure without a surviving copy cannot be repaired by changing the ring.","originalText":"Virtual nodes are not replicas. A hot key still has one owner in this model.\nFailure without a surviving copy cannot be repaired by changing the ring.","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":540002,"version":1,"versionNonce":540002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
