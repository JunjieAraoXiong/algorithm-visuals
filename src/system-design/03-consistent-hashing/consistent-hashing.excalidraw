    {"id":"missing-note","type":"text","x":560,"y":354,"width":480,"height":90,"text":"Before copying: GET(k3) at D -> MISS\nAfter preparing data: GET(k3) -> value\n\nA ring computes ownership. It copies no bytes.","originalText":"Before copying: GET(k3) at D -> MISS\nAfter preparing data: GET(k3) -> value\n\nA ring computes ownership. It copies no bytes.","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","lineHeight":1.25,"strokeColor":"#66645e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":520008,"version":1,"versionNonce":520008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null},
