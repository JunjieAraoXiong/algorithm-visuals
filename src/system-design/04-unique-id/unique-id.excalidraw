    {"id":"time-text","type":"text","x":165,"y":440,"width":350,"height":60,"text":"相对 epoch 的毫秒数\n41 bits","originalText":"相对 epoch 的毫秒数\n41 bits","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":"time-field","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41013,"version":1,"versionNonce":51013,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"dc-field","type":"rectangle","x":540,"y":420,"width":170,"height":100,"strokeColor":"#999999","backgroundColor":"#fffdf8","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41014,"version":1,"versionNonce":51014,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"dc-text","type":"text"}],"link":null,"locked":false,"roundness":null},
    {"id":"dc-text","type":"text","x":560,"y":440,"width":130,"height":60,"text":"机房\n5 bits","originalText":"机房\n5 bits","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":"dc-field","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41015,"version":1,"versionNonce":51015,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"machine-field","type":"rectangle","x":710,"y":420,"width":230,"height":100,"strokeColor":"#272727","backgroundColor":"#ece8df","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"angle":0,"seed":41016,"version":1,"versionNonce":51016,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"machine-text","type":"text"},{"id":"b-to-fields","type":"arrow"}],"link":null,"locked":false,"roundness":null},
    {"id":"machine-text","type":"text","x":730,"y":440,"width":190,"height":60,"text":"机器：1 或 2\n5 bits","originalText":"机器：1 或 2\n5 bits","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":"machine-field","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41017,"version":1,"versionNonce":51017,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"sequence-field","type":"rectangle","x":940,"y":420,"width":200,"height":100,"strokeColor":"#999999","backgroundColor":"#fffdf8","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41018,"version":1,"versionNonce":51018,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"sequence-text","type":"text"}],"link":null,"locked":false,"roundness":null},
    {"id":"sequence-text","type":"text","x":965,"y":440,"width":150,"height":60,"text":"序列\n12 bits","originalText":"序列\n12 bits","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":"sequence-field","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41019,"version":1,"versionNonce":51019,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"layout-note","type":"text","x":40,"y":543,"width":1100,"height":60,"text":"符号位固定为 0；矩形宽度为排版示意，实际位数以标签为准。\n时间相同、序列相同，只要机器身份不同，完整编号仍然不同。","originalText":"符号位固定为 0；矩形宽度为排版示意，实际位数以标签为准。\n时间相同、序列相同，只要机器身份不同，完整编号仍然不同。","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41020,"version":1,"versionNonce":51020,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"formula","type":"text","x":40,"y":630,"width":1100,"height":60,"text":"id = (time << 22) | (dc << 17) | (machine << 12) | sequence\n使用 64 位整数或 BigInt；不要先转成有精度损失的 Number。","originalText":"id = (time << 22) | (dc << 17) | (machine << 12) | sequence\n使用 64 位整数或 BigInt；不要先转成有精度损失的 Number。","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41021,"version":1,"versionNonce":51021,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"boundary-divider","type":"line","x":40,"y":720,"width":1100,"height":0,"strokeColor":"#b7b7b1","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41022,"version":1,"versionNonce":51022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"points":[[0,0],[1100,0]]},
    {"id":"overflow-rule","type":"text","x":40,"y":745,"width":500,"height":120,"text":"序列耗尽\nT / seq = 4095 → 等待\nT + 1 / seq = 0 → 继续\n不能在 T 下直接绕回 0。","originalText":"序列耗尽\nT / seq = 4095 → 等待\nT + 1 / seq = 0 → 继续\n不能在 T 下直接绕回 0。","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41023,"version":1,"versionNonce":51023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"rollback-rule","type":"text","x":640,"y":745,"width":500,"height":120,"text":"时钟回退：本例选择拒绝\nnow < last_time → 不发号\n追平后沿用历史序列，不能清零。\n重启也必须保护历史高水位。","originalText":"时钟回退：本例选择拒绝\nnow < last_time → 不发号\n追平后沿用历史序列，不能清零。\n重启也必须保护历史高水位。","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41024,"version":1,"versionNonce":51024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"tradeoffs-note","type":"text","x":40,"y":900,"width":1100,"height":90,"text":"部署前提：机器身份互斥 · 同机序列原子更新 · 重启恢复策略\n取舍：近似时间顺序不等于严格全局顺序；41 位毫秒时间约覆盖 69 年。\n短链接：完整 Base62 最多可需 11 位，不能直接截成七位。","originalText":"部署前提：机器身份互斥 · 同机序列原子更新 · 重启恢复策略\n取舍：近似时间顺序不等于严格全局顺序；41 位毫秒时间约覆盖 69 年。\n短链接：完整 Base62 最多可需 11 位，不能直接截成七位。","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41025,"version":1,"versionNonce":51025,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"source-note","type":"text","x":40,"y":1020,"width":1100,"height":50,"text":"参考：Alex Xu，《System Design Interview》第二版，第 7 章。\n本图为原创教学草图；故障轨迹与拒绝策略为本例选择。","originalText":"参考：Alex Xu，《System Design Interview》第二版，第 7 章。\n本图为原创教学草图；故障轨迹与拒绝策略为本例选择。","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41026,"version":1,"versionNonce":51026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false}
  ]
}
