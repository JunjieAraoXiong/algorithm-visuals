    {"id":"compose-label","type":"text","x":390,"y":355,"width":400,"height":30,"text":"分别组合各自的字段","originalText":"分别组合各自的字段","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41009,"version":1,"versionNonce":51009,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
