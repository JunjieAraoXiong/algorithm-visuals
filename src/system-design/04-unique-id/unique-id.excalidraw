    {"id":"sign-text","type":"text","x":50,"y":440,"width":80,"height":60,"text":"符号\n1 bit","originalText":"符号\n1 bit","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":"sign-field","lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41011,"version":1,"versionNonce":51011,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
