    {"id":"unique-id-title","type":"text","x":40,"y":25,"width":1080,"height":40,"text":"Unique ID Generator / 唯一 ID 生成器","originalText":"Unique ID Generator / 唯一 ID 生成器","fontSize":32,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#272727","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41001,"version":1,"versionNonce":51001,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
    {"id":"requirements-note","type":"text","x":40,"y":83,"width":1120,"height":60,"text":"需求：64 位整数 · 全局唯一 · 大致按时间排序\n先统一分配机器身份，再让每台机器独立发号。","originalText":"需求：64 位整数 · 全局唯一 · 大致按时间排序\n先统一分配机器身份，再让每台机器独立发号。","fontSize":24,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"lineHeight":1.25,"strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":41002,"version":1,"versionNonce":51002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false},
